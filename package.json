{
  "name": "jing-contracts-v3",
  "version": "1.0.0",
  "description": "Jing v3 protocol + creator-escrow simulations.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "sim:creator-escrow": "tsx simulations/simul-creator-escrow.js",
    "sim:creator-escrow-v2": "tsx simulations/simul-creator-escrow-v2.js",
    "sim:creator-escrow-v2-amend-approve": "tsx simulations/simul-creator-escrow-v2-amend-approve.js",
    "verify:creator-escrow-v2": "tsx simulations/verify-creator-escrow-v2.js",
    "verify:creator-escrow-v3": "tsx simulations/verify-creator-escrow-v3.js",
    "verify:rungs-buy": "SIDE=buy tsx simulations/verify-rungs-keyless.js",
    "verify:rungs-sell": "SIDE=sell tsx simulations/verify-rungs-keyless.js",
    "verify:rung-rounding": "tsx simulations/verify-rung-withdraw-rounding.js",
    "verify:vault-v5-parked": "tsx simulations/verify-vault-sbtc-stx-v5-parked.js",
    "verify:vault-v6-parked": "tsx simulations/verify-vault-sbtc-stx-v6-parked.js",
    "verify:router-v5": "V6=1 tsx simulations/verify-swap-router-v3-lazer.js",
    "verify:v6-rungs-buy": "RUNG=buy tsx simulations/verify-v6-rungs-keyless.js",
    "verify:v6-rungs-sell": "RUNG=sell tsx simulations/verify-v6-rungs-keyless.js",
    "verify:v6-rungs-buy-peg": "RUNG=buy-peg tsx simulations/verify-v6-rungs-keyless.js",
    "verify:v6-rungs-sell-peg": "RUNG=sell-peg tsx simulations/verify-v6-rungs-keyless.js",
    "verify:v6-rungs-fill": "tsx simulations/verify-v6-rungs-fill-lazer.js",
    "verify:v6-peg": "tsx simulations/verify-v6-peg-lazer.js",
    "verify:v6-peg-park": "tsx simulations/verify-v6-peg-park-lazer.js",
    "verify:v6-peg-more": "tsx simulations/verify-v6-peg-more-lazer.js",
    "verify:v6-peg-batch": "tsx simulations/verify-v6-peg-batch-lazer.js",
    "verify:v6-peg-walk-order": "tsx simulations/verify-v6-peg-walk-order-lazer.js",
    "verify:v6-peg-park-y": "tsx simulations/verify-v6-peg-park-y-lazer.js",
    "verify:v6-stress-pegs": "PEGS=1 tsx simulations/verify-markets-v6-stress.js",
    "verify:v6-peg-track": "tsx simulations/verify-v6-peg-track-lazer.js",
    "verify:v6-peg-edges": "tsx simulations/verify-v6-peg-edges-lazer.js",
    "verify:v6-peg-mirror": "tsx simulations/verify-v6-peg-mirror-lazer.js",
    "verify:v6-rungs-push": "tsx simulations/verify-v6-rungs-push-lazer.js",
    "verify:v6-ten-band-deployed": "tsx simulations/verify-v6-ten-band-deployed-lazer.js",
    "verify:markets-v6": "for f in regression multifill withdraw lazer-paths gaps bounty-fixes remainder-cross stress; do tsx simulations/verify-markets-v6-$f.js || exit 1; done",
    "rv:build": "bash tests/rv/build.sh markets-sbtc-stx-jing-v6 && bash tests/rv/build.sh jing-core-v5 && bash tests/rv/build.sh markets-sbtc-stx-jing-v6-on-core && for r in jing-ladder jing-buy-stx jing-sell-stx jing-buy-stx-market-spread jing-sell-stx-market-spread jing-buy-stx-core-spread jing-sell-stx-core-spread; do bash tests/rv/build.sh $r; done && bash tests/rv/build.sh swap-router-sbtc-stx-jing-v5",
    "rv:v6": "rv . markets-sbtc-stx-jing-v6 invariant --runs=1000",
    "rv:ladder": "rv . jing-ladder invariant --runs=500",
    "rv:rungs": "for r in jing-buy-stx jing-sell-stx jing-buy-stx-market-spread jing-sell-stx-market-spread jing-buy-stx-core-spread jing-sell-stx-core-spread; do rv . $r invariant --runs=500 || exit 1; done",
    "rv:core": "rv . markets-sbtc-stx-jing-v6-on-core invariant --runs=1000",
    "rv:v6:props": "rv . markets-sbtc-stx-jing-v6 test --runs=500",
    "rv:core:props": "rv . markets-sbtc-stx-jing-v6-on-core test --runs=300",
    "rv:rungs:props": "for r in jing-buy-stx jing-sell-stx jing-buy-stx-market-spread jing-sell-stx-market-spread jing-buy-stx-core-spread jing-sell-stx-core-spread; do rv . $r test --runs=300 || exit 1; done",
    "rv:router": "rv . swap-router-sbtc-stx-jing-v5 invariant --runs=500",
    "rv:router:props": "rv . swap-router-sbtc-stx-jing-v5 test --runs=500"
  },
  "dependencies": {
    "@stacks/clarinet-sdk": "^3.21.0",
    "@stacks/transactions": "^7.2.0",
    "stxer": "^0.8.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.9",
    "vitest-environment-clarinet": "^3.0.0"
  },
  "devDependencies": {
    "@stacks/rendezvous": "^1.0.0-rc.1"
  }
}
