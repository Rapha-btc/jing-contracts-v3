;; Configurable partial fills; records exact token order/pool/route. Real
;; token transfers let the router's balance-derived final accounting execute.
(define-data-var present bool true)
(define-data-var fill uint u1)
(define-data-var output uint u1)
(define-data-var calls uint u0)
(define-data-var last (optional {x: principal, y: principal, pool: uint, sell-x: bool, amount: uint, price: uint, ticks: (list 32 int), min: uint, partial: bool}) none)
(define-public (configure (exists bool) (sold uint) (received uint)) (ok (begin (var-set present exists) (var-set fill sold) (var-set output received))))
(define-read-only (get-calls) (var-get calls))
(define-read-only (get-last) (var-get last))
(define-read-only (get-fee-rates (pool uint) (who principal))
 (if (and (var-get present) (or (is-eq pool u4) (is-eq pool u3))) (ok {fee-rate-x: u0, fee-rate-y: u0}) (err u404)))
(define-private (trade (x principal) (y principal) (pool uint) (amount uint) (price uint) (ticks (list 32 int)) (min uint) (partial bool) (sell-x bool))
 (let ((who tx-sender) (sold (var-get fill)) (received (var-get output)))
 (asserts! (var-get present) (err u404))
 (asserts! (is-eq x .sbtc) (err u901))
 (asserts! (or (is-eq y .usdcx) (is-eq y .wstx)) (err u902))
 (var-set calls (+ (var-get calls) u1))
 (var-set last (some {x: x, y: y, pool: pool, sell-x: sell-x, amount: amount, price: price, ticks: ticks, min: min, partial: partial}))
 (if sell-x
  (begin
   (try! (contract-call? .sbtc transfer sold who current-contract none))
   (if (is-eq y .usdcx)
    (try! (as-contract? ((with-ft .usdcx "usdcx-token" received)) (try! (contract-call? .usdcx transfer received current-contract who none))))
    (try! (as-contract? ((with-stx received)) (try! (stx-transfer? received current-contract who)))))
   (ok {dx: sold, dy: received}))
  (begin
   (if (is-eq y .usdcx) (try! (contract-call? .usdcx transfer sold who current-contract none)) (try! (stx-transfer? sold who current-contract)))
   (try! (as-contract? ((with-ft .sbtc "sbtc-token" received)) (try! (contract-call? .sbtc transfer received current-contract who none))))
   (ok {dx: received, dy: sold}))))
)
(define-public (swap-x-for-y (x principal) (y principal) (pool uint) (amount uint) (price uint) (ticks (list 32 int)) (min uint) (partial bool) (deadline uint))
 (trade x y pool amount price ticks min partial true))
(define-public (swap-y-for-x (x principal) (y principal) (pool uint) (amount uint) (price uint) (ticks (list 32 int)) (min uint) (partial bool) (deadline uint))
 (trade x y pool amount price ticks min partial false))
