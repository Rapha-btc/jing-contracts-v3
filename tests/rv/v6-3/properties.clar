    (and (is-eq (fold rv-live-y RV-ACCOUNTS u0) (get total-token-y (get-cycle-totals (var-get current-cycle))))
         (is-eq (fold rv-live-y book u0) (fold rv-live-y RV-ACCOUNTS u0))
