(define-read-only (invariant-solvent-y)
  (and (>= (rv-balance-y current-contract) (fold rv-sum-y RV-ACCOUNTS u0))
       (is-eq (contract-call? .mock-ft get-minted current-contract) u0)))
(define-read-only (invariant-totals-y)
