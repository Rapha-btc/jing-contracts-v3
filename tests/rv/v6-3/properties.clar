(define-public (test-reprice-x (price uint))
 (begin (asserts! true (err u9900))
  (match (reprice-or-swap-token-x (rv-price price) none 0x .mock-ft "mock-ft" .mock-ft "mock-ft") r (begin (print {rv-success: "test-reprice-x"}) (ok true)) e (ok false))))

(define-read-only (rv-balance-y (who principal)) (stx-get-balance who))
(define-read-only (rv-pending-y (who principal))
  (default-to u0 (get amount (map-get? token-y-pending-deposits who))))
(define-read-only (rv-owned-y (who principal))
