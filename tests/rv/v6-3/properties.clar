(define-private (rv-all)
  (and (invariant-properties) (invariant-solvent-x) (invariant-solvent-y)
    (invariant-totals-x) (invariant-totals-y)
    (invariant-pending-positive-x) (invariant-pending-positive-y)))
(define-public (test-state)
  (rv-check (rv-all)))
(define-public (test-batch-at (who principal) (x bool))
  (let ((price (if x (get-token-x-limit who) (get-token-y-limit who))))
    (asserts! (> price u0) (ok false))
    (try! (contract-call? .mock-lazer-oracle set-mid price))
    (test-batch)))
