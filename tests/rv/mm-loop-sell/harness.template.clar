;; Rendezvous wrapper and invariants for the unmodified vault source.
(define-constant RV-MAX-AMOUNT u1000000000)
(define-constant RV-RUNGS (list .rung-1 .rung-10 .rung-20 .rung-30 .rung-40 .rung-50 .rung-60 .rung-70 .rung-80 .rung-90))
(define-data-var rv-valid bool true)
(define-data-var rv-withdraw-valid bool true)
(define-data-var rv-booking-valid bool true)
(define-data-var rv-sats-anchor uint u0)
(define-data-var rv-sats-deposited uint u0)
(define-read-only (rv-status)
  {valid: (var-get rv-valid), withdraw-valid: (var-get rv-withdraw-valid), booking-valid: (var-get rv-booking-valid)})
(define-read-only (rv-sats-total)
  (+ (unwrap-panic (contract-call? .token get-balance .vault))
     (unwrap-panic (contract-call? .token get-balance .market))
     (unwrap-panic (contract-call? .token get-balance .rung-1))
     (unwrap-panic (contract-call? .token get-balance .rung-10))
     (unwrap-panic (contract-call? .token get-balance .rung-20))
     (unwrap-panic (contract-call? .token get-balance .rung-30))
     (unwrap-panic (contract-call? .token get-balance .rung-40))
     (unwrap-panic (contract-call? .token get-balance .rung-50))
     (unwrap-panic (contract-call? .token get-balance .rung-60))
     (unwrap-panic (contract-call? .token get-balance .rung-70))
     (unwrap-panic (contract-call? .token get-balance .rung-80))
     (unwrap-panic (contract-call? .token get-balance .rung-90))))
(define-public (update-context (function-name (string-ascii 100)) (called uint))
  (begin
    (if (is-eq (var-get rv-sats-anchor) u0) (var-set rv-sats-anchor (rv-sats-total)) true)
    (ok true)))
(define-private (rv-audit (deposit uint))
  (let ((total (rv-sats-total)) (allowed (+ (var-get rv-sats-anchor) (var-get rv-sats-deposited) deposit)))
    (if (or (> total allowed) (not (var-get rv-withdraw-valid)))
      (begin (var-set rv-valid false) (err u8998))
      (begin
        (if (> deposit u0) (var-set rv-sats-deposited (+ (var-get rv-sats-deposited) deposit)) true)
        (ok true)))))
(define-private (rv-rung (index uint)) (unwrap-panic (element-at RV-RUNGS (mod index u10))))
@@TARGET_DISPATCH@@
@@KEEPER_AGENT@@

;; Property actions. Rejected vault operations are deliberately caught so each
;; random call still proceeds to the next invariant check.
(define-public (test-deposit-sats (raw uint))
  (let ((amount (+ u1 (mod raw u1000000))))
    (match (contract-call? .token transfer amount tx-sender .vault none)
      okv (rv-audit amount)
      err (rv-audit u0))))
(define-public (test-sell (index uint) (raw uint))
  (let ((amount (+ u1 (mod raw u1000000))))
    (match (rv-sell index amount) okv (rv-audit u0) err (rv-audit u0))))
(define-public (test-claim (index uint))
  (match (rv-claim index) okv (rv-audit u0) err (rv-audit u0)))
(define-public (test-donate-proceeds (index uint) (raw uint))
  (let ((amount (+ u1 (mod raw u1000000)))
        (before (contract-call? .vault get-state)))
    (match (rv-sell index u1)
      sold (match (rv-donate index amount)
        donated (match (rv-claim index)
          consumed (let ((after (contract-call? .vault get-state)))
            (if (and (is-eq consumed u0)
                     (> (get @@PROCEEDS_INVENTORY@@ after) (get @@PROCEEDS_INVENTORY@@ before)))
              (var-set rv-booking-valid false)
              true)
            (rv-audit @@DONATION_SATS@@))
          err (rv-audit u0))
        err (rv-audit u0))
      err (rv-audit u0))))
(define-public (test-rung-withdraw (index uint) (raw uint))
  (let ((amount (+ u1 (mod raw u1000000))))
    (match (rv-rung-withdraw index amount) okv (rv-audit u0) err (rv-audit u0))))
(define-public (test-buy-back (raw uint) (spread uint))
  (let ((s (contract-call? .vault get-state)))
    (if (and (is-eq (get @@MARKET_OPEN@@ s) u0)
             (> (get @@CAP_OR_FLOOR@@ s) u0)
             (> (get @@OPEN_INVENTORY@@ s) (get @@MARKET_OPEN@@ s)))
      (match (rv-buy-back raw spread) okv (rv-audit u0) err (rv-audit u0))
      (rv-audit u0))))
(define-public (test-reprice (spread uint))
  (let ((s (contract-call? .vault get-state)))
    (if (and (> (get @@MARKET_OPEN@@ s) u0)
             (> (get inv-sats s) u0)
             (> (get @@CAP_OR_FLOOR@@ s) u0))
      (match (contract-call? .vault reprice (mod spread u10000)) okv (rv-audit u0) err (rv-audit u0))
      (rv-audit u0))))
(define-public (test-reconcile)
  (match (contract-call? .vault reconcile) okv (rv-audit u0) err (rv-audit u0)))
(define-public (test-fill-market (raw uint))
  (match (rv-fill raw) okv (rv-audit u0) err (rv-audit u0)))
(define-public (test-cancel-buy-back)
  (let ((s (contract-call? .vault get-state)))
    (if (> (get @@MARKET_OPEN@@ s) u0)
      (match (contract-call? .vault cancel-buy-back) okv (rv-audit u0) err (rv-audit u0))
      (rv-audit u0))))
(define-public (test-withdraw-stx (raw uint))
  (let ((amount (+ u1 (mod raw u1000000)))
        (owner-before (stx-get-balance current-contract))
        (caller-before (stx-get-balance tx-sender)))
    (match (contract-call? .vault withdraw-stx amount)
      paid (begin
        (if (and (is-eq (stx-get-balance current-contract) (+ owner-before amount))
                 (is-eq (stx-get-balance tx-sender) caller-before)) true (var-set rv-withdraw-valid false))
        (rv-audit u0))
      err (rv-audit u0))))
(define-public (test-withdraw-sbtc (raw uint))
  (let ((amount (+ u1 (mod raw u1000000)))
        (owner-before (unwrap-panic (contract-call? .token get-balance current-contract)))
        (caller-before (unwrap-panic (contract-call? .token get-balance tx-sender)))
        (vault-before (unwrap-panic (contract-call? .token get-balance .vault)))
        (held (unwrap-panic (contract-call? .token get-balance .vault))))
    (match (contract-call? .vault withdraw-sbtc amount)
      paid (begin
        (if (and (is-eq (unwrap-panic (contract-call? .token get-balance current-contract)) (+ owner-before amount))
                 (is-eq (unwrap-panic (contract-call? .token get-balance tx-sender)) caller-before)
                 (is-eq (+ (unwrap-panic (contract-call? .token get-balance .vault)) amount) vault-before)) true
          (var-set rv-withdraw-valid false))
        (rv-audit u0))
      err (rv-audit u0))))
(define-public (test-edge (raw uint))
  (match (contract-call? .vault set-edge-bps (mod raw u10000)) okv (rv-audit u0) err (rv-audit u0)))
(define-public (test-pause (raw uint))
  (match (contract-call? .vault set-paused (is-eq (mod raw u2) u1)) okv (rv-audit u0) err (rv-audit u0)))
(define-public (test-owner-cycle)
  (begin
    (try! (contract-call? .vault propose-owner (some current-contract)))
    (try! (contract-call? .vault accept-owner))
    (try! (contract-call? .vault propose-owner none))
    (rv-audit u0)))
(define-public (test-keeper-remove)
  (match (contract-call? .vault set-keeper none) okv (rv-audit u0) err (rv-audit u0)))
(define-public (test-keeper-restore)
  (match (contract-call? .vault set-keeper (some .keeper-agent)) okv (rv-audit u0) err (rv-audit u0)))
(define-public (test-keeper-withdraw (raw uint))
  (let ((amount (+ u1 (mod raw u1000000)))
        (owner-stx (stx-get-balance current-contract))
        (owner-token (unwrap-panic (contract-call? .token get-balance current-contract)))
        (agent-stx (stx-get-balance .keeper-agent))
        (agent-token (unwrap-panic (contract-call? .token get-balance .keeper-agent))))
    (match (contract-call? .keeper-agent try-withdraw-stx amount) paid true error true)
    (match (contract-call? .keeper-agent try-withdraw-sbtc amount) paid true error true)
    (if (> (get @@MARKET_OPEN@@ (contract-call? .vault get-state)) u0)
      (match (contract-call? .keeper-agent try-cancel) paid true error true)
      true)
    (match (contract-call? .keeper-agent try-rung-withdraw u0 amount) paid true error true)
    (if (and (is-eq owner-stx (stx-get-balance current-contract))
             (is-eq owner-token (unwrap-panic (contract-call? .token get-balance current-contract)))
             (is-eq agent-stx (stx-get-balance .keeper-agent))
             (is-eq agent-token (unwrap-panic (contract-call? .token get-balance .keeper-agent)))) true
      (var-set rv-withdraw-valid false))
    (rv-audit u0)))
(define-public (test-get-state)
  (let ((state (contract-call? .vault get-state))) (rv-audit u0)))

;; Invariants checked by Rendezvous after each randomly selected call.
(define-read-only (invariant-inventory-pair)
  (let ((s (contract-call? .vault get-state)))
    (is-eq (is-eq (get inv-sats s) u0) (is-eq (get inv-stx s) u0))))
(define-read-only (invariant-cap-or-floor)
  (let ((s (contract-call? .vault get-state)))
    (<= (get @@CAP_OR_FLOOR@@ s) (get vwap-sell s))))
(define-read-only (invariant-edge)
  (< (get edge-bps (contract-call? .vault get-state)) u10000))
(define-read-only (invariant-market-open)
  (let ((s (contract-call? .vault get-state)))
    (<= (get @@MARKET_OPEN@@ s) (get @@OPEN_INVENTORY@@ s))))
(define-read-only (invariant-rung-domain)
  (and
    (is-eq (contract-call? .vault get-rung-principal .keeper-agent) u0)
    (is-eq (contract-call? .vault get-rung-principal .market) u0)
    (is-eq (contract-call? .vault get-rung-principal .token) u0)
    (is-eq (contract-call? .vault get-rung-principal current-contract) u0)))
(define-read-only (invariant-withdraw-authority) (var-get rv-withdraw-valid))
(define-read-only (invariant-rung-booking) (var-get rv-booking-valid))
(define-read-only (invariant-total-sats-nonincrease)
  (and (var-get rv-valid)
       (<= (rv-sats-total) (+ (var-get rv-sats-anchor) (var-get rv-sats-deposited)))))
(define-read-only (invariant-all)
  (and (invariant-inventory-pair) (invariant-cap-or-floor) (invariant-edge)
       (invariant-market-open) (invariant-rung-domain) (invariant-withdraw-authority)
       (invariant-rung-booking) (invariant-total-sats-nonincrease)))
