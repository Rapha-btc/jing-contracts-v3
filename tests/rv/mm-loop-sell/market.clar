(use-trait ft-trait .sip-010-trait.sip-010-trait)
(define-constant ERR_NOTHING (err u1005))
(define-map token-x-pending principal {amount: uint, limit: uint, spread-bps: (optional uint)})
(define-map token-y-pending principal {amount: uint, limit: uint, spread-bps: (optional uint)})
(define-read-only (get-current-cycle) u0)
(define-read-only (get-token-x-deposit (cycle uint) (who principal)) u0)
(define-read-only (get-token-y-deposit (cycle uint) (who principal)) u0)
(define-read-only (get-token-x-parked (who principal)) u0)
(define-read-only (get-token-y-parked (who principal)) u0)
(define-read-only (get-token-x-pending-deposit (who principal)) (map-get? token-x-pending who))
(define-read-only (get-token-y-pending-deposit (who principal)) (map-get? token-y-pending who))
(define-public (deposit-token-x (amount uint) (limit-price uint) (spread-bps (optional uint)) (token <ft-trait>) (asset-name (string-ascii 128)))
  (begin
    (asserts! (is-none (map-get? token-x-pending tx-sender)) (err u1001))
    (try! (contract-call? token transfer amount tx-sender current-contract none))
    (map-set token-x-pending tx-sender {amount: amount, limit: limit-price, spread-bps: spread-bps})
    (ok amount)))
(define-public (deposit-token-y (amount uint) (limit-price uint) (spread-bps (optional uint)) (token <ft-trait>) (asset-name (string-ascii 128)))
  (begin
    (asserts! (is-none (map-get? token-y-pending tx-sender)) (err u1001))
    (try! (stx-transfer? amount tx-sender current-contract))
    (map-set token-y-pending tx-sender {amount: amount, limit: limit-price, spread-bps: spread-bps})
    (ok amount)))
(define-public (set-token-x-limit (limit-price uint) (spread-bps (optional uint)))
  (match (map-get? token-x-pending tx-sender)
    p (begin (map-set token-x-pending tx-sender (merge p {limit: limit-price, spread-bps: spread-bps})) (ok true))
    ERR_NOTHING))
(define-public (set-token-y-limit (limit-price uint) (spread-bps (optional uint)))
  (match (map-get? token-y-pending tx-sender)
    p (begin (map-set token-y-pending tx-sender (merge p {limit: limit-price, spread-bps: spread-bps})) (ok true))
    ERR_NOTHING))
(define-public (cancel-token-x-deposit (token <ft-trait>) (asset-name (string-ascii 128)))
  (match (map-get? token-x-pending tx-sender)
    p (let ((amount (get amount p)) (who tx-sender))
        (map-delete token-x-pending who)
        (try! (as-contract? ((with-ft .token "token" amount))
          (try! (contract-call? token transfer amount current-contract who none))))
        (ok amount))
    ERR_NOTHING))
(define-public (cancel-token-y-deposit (token <ft-trait>) (asset-name (string-ascii 128)))
  (match (map-get? token-y-pending tx-sender)
    p (let ((amount (get amount p)) (who tx-sender))
        (map-delete token-y-pending who)
        (try! (as-contract? ((with-stx amount)) (try! (stx-transfer? amount current-contract who))))
        (ok amount))
    ERR_NOTHING))
;; Harness-only external fills. They remove open market inventory and send the
;; acquired asset to the vault while keeping the tracked sBTC ledger conserved.
(define-public (rv-fill-token-x (who principal) (amount uint) (token <ft-trait>))
  (match (map-get? token-x-pending who)
    p (let ((take (if (> amount (get amount p)) (get amount p) amount))
            (left (- (get amount p) (if (> amount (get amount p)) (get amount p) amount))))
        (if (is-eq left u0) (map-delete token-x-pending who)
          (map-set token-x-pending who (merge p {amount: left})))
        (try! (as-contract? ((with-stx take)) (try! (stx-transfer? take current-contract who))))
        (ok take))
    (ok u0)))
(define-public (rv-fill-token-y (who principal) (amount uint) (token <ft-trait>))
  (match (map-get? token-y-pending who)
    p (let ((take (if (> amount (get amount p)) (get amount p) amount))
            (left (- (get amount p) (if (> amount (get amount p)) (get amount p) amount))))
        (if (is-eq left u0) (map-delete token-y-pending who)
          (map-set token-y-pending who (merge p {amount: left})))
        (try! (as-contract? ((with-ft .token "token" take))
          (try! (contract-call? token transfer take current-contract who none))))
        (ok take))
    (ok u0)))
