(impl-trait .rung-trait.rung-trait)
(define-map positions principal uint)
(define-map donated-sbtc principal uint)
(define-read-only (position (who principal)) (default-to u0 (map-get? positions who)))
(define-read-only (get-position (who principal))
  {sbtc: (position who), stx: (position who)})
(define-public (rv-donate (who principal) (amount uint))
  (begin
    (try! (contract-call? .token transfer amount tx-sender current-contract none))
    (map-set donated-sbtc who (+ (default-to u0 (map-get? donated-sbtc who)) amount))
    (ok true)))
(define-public (deposit (amount uint))
  (begin
    (try! (stx-transfer? amount tx-sender current-contract))
    (map-set positions tx-sender (+ (position tx-sender) amount))
    (ok {amount: amount, shares: amount, epoch: u0, stx-paid: u0, sbtc-paid: u0})))
(define-public (claim)
  (let ((who tx-sender) (donation (default-to u0 (map-get? donated-sbtc tx-sender))))
    (if (> donation u0)
      (begin
        (map-delete donated-sbtc who)
        (try! (as-contract? ((with-ft .token "token" donation))
          (try! (contract-call? .token transfer donation current-contract who none))))
        (ok {stx: u0, sbtc: donation}))
      (let ((held (position tx-sender)) (take (if (> (position tx-sender) u0) u1 u0)))
        (if (> take u0)
          (begin
            (map-set positions who (- held take))
            (try! (as-contract? ((with-stx take)) (try! (stx-transfer? take current-contract .market))))
            (try! (as-contract? ((with-ft .token "token" take))
              (try! (contract-call? .token transfer take current-contract who none))))
            (ok {stx: u0, sbtc: take}))
          (ok {stx: u0, sbtc: u0}))))))
(define-public (withdraw (amount uint) (update (optional (buff 8192))))
  (let ((who tx-sender) (held (position tx-sender)) (take (if (> amount (position tx-sender)) (position tx-sender) amount)))
    (map-set positions who (- held take))
    (if (> take u0) (try! (as-contract? ((with-stx take)) (try! (stx-transfer? take current-contract who)))) true)
    (ok {stx: take, sbtc: u0})))
